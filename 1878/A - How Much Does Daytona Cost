#include<iostream>
using namespace std;
int main()
{
    int a;
    cin>>a;
    for(int i=1;i<=a;i++)
    {
        int n;
        cin>>n;
        int k;
        cin>>k;
        int arr[n];
        for(int j=0;j<n;j++)
        {
            cin>>arr[j];
        }
        int c=0;
        for(int l=0;l<n;l++)
        {
            if(arr[l]==k)
            {
                c++;
                break;
            }
        }
        if(c==1)
        cout<<"YES"<<endl;
        else
        cout<<"NO"<<endl;
    }
}